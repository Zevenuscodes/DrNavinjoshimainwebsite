# Email booking alerts (SMTP, Gmail by default)
# Gmail address that sends the alert, and a Google "App password" for it (not the normal password)
SMTP_USER=
SMTP_PASS=
# Inbox that receives the alert. Defaults to nchjoshi@gmail.com
BOOKING_NOTIFY_EMAIL=nchjoshi@gmail.com
# Only needed for a non-Gmail provider
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# WhatsApp booking alerts (Meta WhatsApp Cloud API)
# Permanent access token of a system user with whatsapp_business_messaging permission
WHATSAPP_ACCESS_TOKEN=
# Phone number ID of the WhatsApp Business sender number (not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# Number(s) that receive the alert, country code without +, comma-separated. Defaults to 919411137993
WHATSAPP_NOTIFY_TO=919411137993
# Approved template with 7 body variables: name, phone, email, mode, date, time, notes
WHATSAPP_TEMPLATE_NAME=new_booking_alert
WHATSAPP_TEMPLATE_LANG=en
